Problem URL -


Solution -


Select 
    b.book_id, b.name
FROM 
    Books b 
LEFT JOIN (
    SELECT book_id, SUM(quantity) nsold
    FROM Orders
    WHERE dispatch_date BETWEEN '2018-06-23' AND '2019-06-23'
    GROUP BY book_id
) o
    ON b.book_id = o.book_id
WHERE 
(o.nsold < 10 OR o.nsold IS NULL) AND
DATEDIFF('2019-06-23', b.available_from) > 30
